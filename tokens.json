{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Sumi-Ink Command System",
  "version": "0.1.0",
  "status": "approved-baseline",
  "colors": {
    "ink": "#0D0A0A",
    "paper": "#FFFFFF",
    "softPaper": "#FAFAFA",
    "mist": "#F5F5F5",
    "wash": "#F7F5F4",
    "paleRule": "#EDEDED",
    "rule": "#E0E0E0",
    "muted": "#545554",
    "seal": "#C23A2E",
    "sealDeep": "#8F211A",
    "sealWash": "#F5E5E3",
    "okay": "#2F3A2F",
    "dangerField": "#FFEDED"
  },
  "typography": {
    "displayFamily": "Times New Roman, Baskerville, Georgia, serif",
    "bodyFamily": "Hiragino Mincho ProN, Yu Mincho, Times New Roman, Georgia, serif",
    "labelFamily": "SFMono-Regular, Consolas, Liberation Mono, monospace",
    "displaySize": "46px",
    "headlineSize": "28px",
    "titleSize": "18px",
    "bodySize": "14px",
    "labelSize": "10px",
    "bodyLineHeight": "1.58",
    "labelTracking": "0.14em"
  },
  "spacing": {
    "1": "1px",
    "2": "2px",
    "4": "4px",
    "6": "6px",
    "7": "7px",
    "8": "8px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "18": "18px",
    "24": "24px",
    "32": "32px"
  },
  "shape": {
    "radius": "0px",
    "borderWidth": "1px",
    "focusWidth": "2px",
    "focusOffset": "3px"
  },
  "componentSizes": {
    "touchTarget": "44px",
    "compactTarget": "34px",
    "dropdownMinimumWidth": "216px",
    "iconSmall": "14px",
    "iconMedium": "18px"
  },
  "motion": {
    "instant": "80ms",
    "control": "160ms",
    "panel": "200ms",
    "reduced": "0.001ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "breakpoints": {
    "compact": "720px",
    "tablet": "980px",
    "wide": "1280px"
  },
  "accessibility": {
    "minimumContrast": "4.5:1",
    "focusMustBeVisible": true,
    "colorCannotBeSoleState": true,
    "reducedMotionRequired": true,
    "rtlRequiredForArabic": true
  }
}
